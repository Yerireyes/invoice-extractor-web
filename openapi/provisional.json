{
  "openapi": "3.1.0",
  "info": {
    "title": "Invoice Extractor API",
    "version": "1.0.0",
    "description": "PROVISIONAL: endpoints the backend has not published yet (extract, exports), derived from buzon/contrato/api-contract.md. Refs point to published schemas. Merged by npm run sync:api.",
    "x-provisional": true
  },
  "paths": {
    "/api/v1/invoices/extract": {
      "post": {
        "operationId": "extractInvoices",
        "summary": "Extract invoices from 1..N files (partial success allowed)",
        "tags": [
          "invoices"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResponse"
                }
              }
            }
          },
          "413": {
            "description": "File too large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "LLM unavailable or quota exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exports/excel": {
      "post": {
        "operationId": "exportExcel",
        "summary": "Invoices → .xlsx",
        "tags": [
          "exports"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File download (Content-Disposition: attachment; filename=…)",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exports/pdf": {
      "post": {
        "operationId": "exportPdf",
        "summary": "Invoices → .pdf (one invoice per page)",
        "tags": [
          "exports"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File download (Content-Disposition: attachment; filename=…)",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExtractionMeta": {
        "type": "object",
        "required": [
          "provider",
          "model",
          "pages",
          "processing_ms"
        ],
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/LLMProvider"
          },
          "model": {
            "type": "string"
          },
          "pages": {
            "type": "integer"
          },
          "processing_ms": {
            "type": "integer"
          }
        }
      },
      "FileError": {
        "type": "object",
        "required": [
          "code",
          "params"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "NOT_AN_INVOICE | UNREADABLE_FILE | UNSUPPORTED_FILE_TYPE | FILE_TOO_LARGE | PDF_TOO_MANY_PAGES | EXTRACTION_FAILED"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ExtractionSuccess": {
        "type": "object",
        "required": [
          "file_name",
          "status",
          "invoice",
          "validation",
          "field_confidence",
          "meta"
        ],
        "properties": {
          "file_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "const": "success"
          },
          "invoice": {
            "$ref": "#/components/schemas/Invoice"
          },
          "validation": {
            "$ref": "#/components/schemas/Validation"
          },
          "field_confidence": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ExtractionMeta"
          }
        }
      },
      "ExtractionFailure": {
        "type": "object",
        "required": [
          "file_name",
          "status",
          "error"
        ],
        "properties": {
          "file_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "const": "error"
          },
          "error": {
            "$ref": "#/components/schemas/FileError"
          }
        }
      },
      "ExtractionResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ExtractionSuccess"
          },
          {
            "$ref": "#/components/schemas/ExtractionFailure"
          }
        ],
        "discriminator": {
          "propertyName": "status",
          "mapping": {
            "success": "#/components/schemas/ExtractionSuccess",
            "error": "#/components/schemas/ExtractionFailure"
          }
        }
      },
      "ExtractSummary": {
        "type": "object",
        "required": [
          "total",
          "succeeded",
          "failed"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "succeeded": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          }
        }
      },
      "ExtractResponse": {
        "type": "object",
        "required": [
          "results",
          "summary"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtractionResult"
            }
          },
          "summary": {
            "$ref": "#/components/schemas/ExtractSummary"
          }
        }
      },
      "ExtractRequest": {
        "type": "object",
        "required": [
          "files"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "binary"
            }
          },
          "provider": {
            "$ref": "#/components/schemas/LLMProvider"
          }
        }
      },
      "ExportOptions": {
        "type": "object",
        "required": [
          "language",
          "include_line_items",
          "include_alerts"
        ],
        "properties": {
          "language": {
            "$ref": "#/components/schemas/ExportLanguage"
          },
          "include_line_items": {
            "type": "boolean"
          },
          "include_alerts": {
            "type": "boolean"
          }
        }
      },
      "ExportRequest": {
        "type": "object",
        "required": [
          "invoices",
          "options"
        ],
        "properties": {
          "invoices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Invoice"
            }
          },
          "options": {
            "$ref": "#/components/schemas/ExportOptions"
          }
        }
      }
    }
  }
}
