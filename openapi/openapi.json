              {
                "type": "null"
              }
            ],
            "title": "Unit Price"
          },
          "discount": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Discount"
