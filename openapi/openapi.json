          "tax_rate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Tax Rate",
            "description": "Porcentaje (`16` = 16 %)."
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
            "title": "Amount",
            "description": "cantidad * precio unitario - descuento",
            "examples": [
              "1234.50"
            ]
          }
        },
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "LineItem"
      },
