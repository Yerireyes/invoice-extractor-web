                "type": "null"
              }
            ],
            "title": "Rate",
            "description": "Porcentaje (`16` = 16 %)."
          },
          "base": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Base"
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
            "title": "Amount",
            "examples": [
