{
  "openapi": "3.1.0",
  "info": {
    "title": "Invoice Extractor API",
    "summary": "Extrae datos de facturas de cualquier país con IA y los exporta a Excel y PDF.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Comprobación de salud",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Límites, formatos aceptados, proveedores e idiomas de exportación",
        "operationId": "meta_api_v1_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invoices/validate": {
      "post": {
        "tags": [
          "invoices"
        ],
        "summary": "Revalida una factura editada (no llama a la IA)",
        "operationId": "validate_api_v1_invoices_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResponse"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exports/excel": {
      "post": {
        "tags": [
          "exports"
        ],
        "summary": "Exporta facturas a Excel (.xlsx)",
        "operationId": "export_excel_api_v1_exports_excel_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Archivo generado (`Content-Disposition: attachment`)",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exports/pdf": {
      "post": {
        "tags": [
          "exports"
        ],
        "summary": "Exporta facturas a PDF (una factura por página)",
        "operationId": "export_pdf_api_v1_exports_pdf_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Archivo generado (`Content-Disposition: attachment`)",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invoices/extract": {
      "post": {
        "tags": [
          "invoices"
        ],
        "summary": "Sube 1..N facturas (imágenes o PDF) y devuelve sus datos extraídos y validados",
        "operationId": "extract_api_v1_invoices_extract_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extract_api_v1_invoices_extract_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResponse"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_extract_api_v1_invoices_extract_post": {
        "properties": {
          "files": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "contentMediaType": "application/octet-stream"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Files",
            "description": "Imágenes (JPEG, PNG, WebP) o PDF"
          },
          "provider": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LLMProvider"
              },
              {
                "type": "null"
              }
            ],
            "description": "Proveedor de IA; por defecto el de `/meta`"
          }
        },
        "type": "object",
        "title": "Body_extract_api_v1_invoices_extract_post"
      },
      "DocumentType": {
        "type": "string",
        "enum": [
          "invoice",
          "receipt",
          "credit_note",
          "other"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "TOO_MANY_FILES",
          "NO_FILES",
          "TOO_MANY_INVOICES",
          "VALIDATION_ERROR",
          "PROVIDER_NOT_AVAILABLE",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "REQUEST_TOO_LARGE",
          "RATE_LIMITED",
          "LLM_QUOTA_EXCEEDED",
          "LLM_UNAVAILABLE",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "description": "Códigos de error HTTP del contrato (sección 5)."
      },
      "ExportInvoice": {
        "properties": {
          "document_type": {
            "$ref": "#/components/schemas/DocumentType",
            "default": "invoice"
          },
          "invoice_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoice Number"
          },
          "issue_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issue Date",
            "description": "Obligatorio (validación)."
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Date"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10,
                "minLength": 1,
                "description": "ISO 4217 (p. ej. `MXN`). Si no es válido, la validación lo marca."
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency",
            "description": "Obligatorio (validación)."
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "description": "ISO 3166-1 alfa-2 (p. ej. `MX`)."
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "description": "ISO 639-1 (p. ej. `es`)."
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "issuer": {
            "$ref": "#/components/schemas/Party"
          },
          "recipient": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Party"
              },
              {
                "type": "null"
              }
            ]
          },
          "line_items": {
            "items": {
              "$ref": "#/components/schemas/LineItem"
            },
            "type": "array",
            "title": "Line Items"
          },
          "subtotal": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtotal"
          },
          "discount_total": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Discount Total"
          },
          "taxes": {
            "items": {
              "$ref": "#/components/schemas/Tax"
            },
            "type": "array",
            "title": "Taxes"
          },
          "total": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Total",
            "description": "Obligatorio (validación)."
          },
          "payment_method": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Method"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "source_file_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Source File Name",
            "description": "Nombre del archivo original (el de `/extract`)."
          }
        },
        "type": "object",
        "title": "ExportInvoice",
        "description": "Factura a exportar. `source_file_name` (opcional) rellena la columna *Archivo*."
      },
      "ExportLanguage": {
        "type": "string",
        "enum": [
          "es",
          "en"
        ]
      },
      "ExportOptions": {
        "properties": {
          "language": {
            "$ref": "#/components/schemas/ExportLanguage",
            "default": "es"
          },
          "include_line_items": {
            "type": "boolean",
            "title": "Include Line Items",
            "default": true
          },
          "include_alerts": {
            "type": "boolean",
            "title": "Include Alerts",
            "default": true
          }
        },
        "type": "object",
        "title": "ExportOptions"
      },
      "ExportRequest": {
        "properties": {
          "invoices": {
            "items": {
              "$ref": "#/components/schemas/ExportInvoice"
            },
            "type": "array",
            "minItems": 1,
            "title": "Invoices"
          },
          "options": {
            "$ref": "#/components/schemas/ExportOptions"
          }
        },
        "type": "object",
        "required": [
          "invoices"
        ],
        "title": "ExportRequest"
      },
      "ExtractResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/ExtractionResult"
            },
            "type": "array",
            "title": "Results"
          },
          "summary": {
            "$ref": "#/components/schemas/ExtractSummary"
          }
        },
        "type": "object",
        "required": [
          "results",
          "summary"
        ],
        "title": "ExtractResponse"
      },
      "ExtractSummary": {
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0,
            "title": "Total"
          },
          "succeeded": {
            "type": "integer",
            "minimum": 0,
            "title": "Succeeded"
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "title": "Failed"
          }
        },
        "type": "object",
        "required": [
          "total",
          "succeeded",
          "failed"
        ],
        "title": "ExtractSummary"
      },
      "ExtractionFailure": {
        "properties": {
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "status": {
            "type": "string",
            "const": "error",
            "title": "Status",
            "default": "error"
          },
          "error": {
            "$ref": "#/components/schemas/FileError"
          }
        },
        "type": "object",
        "required": [
          "file_name",
          "error"
        ],
        "title": "ExtractionFailure"
      },
      "ExtractionMeta": {
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/LLMProvider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "pages": {
            "type": "integer",
            "minimum": 1,
            "title": "Pages"
          },
          "processing_ms": {
            "type": "integer",
            "minimum": 0,
            "title": "Processing Ms"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "model",
          "pages",
          "processing_ms"
        ],
        "title": "ExtractionMeta"
      },
      "ExtractionResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ExtractionSuccess"
          },
          {
            "$ref": "#/components/schemas/ExtractionFailure"
          }
        ],
        "title": "ExtractionResult",
        "description": "Resultado por archivo: unión discriminada por `status` (`success` | `error`).",
        "discriminator": {
          "propertyName": "status",
          "mapping": {
            "error": "#/components/schemas/ExtractionFailure",
            "success": "#/components/schemas/ExtractionSuccess"
          }
        }
      },
      "ExtractionSuccess": {
        "properties": {
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "status": {
            "type": "string",
            "const": "success",
            "title": "Status",
            "default": "success"
          },
          "invoice": {
            "$ref": "#/components/schemas/Invoice"
          },
          "validation": {
            "$ref": "#/components/schemas/Validation"
          },
          "field_confidence": {
            "additionalProperties": {
              "type": "number",
              "maximum": 1,
              "minimum": 0
            },
            "type": "object",
            "title": "Field Confidence",
            "description": "Confianza 0..1 por campo, en notación de ruta (`issuer.tax_id`)."
          },
          "meta": {
            "$ref": "#/components/schemas/ExtractionMeta"
          }
        },
        "type": "object",
        "required": [
          "file_name",
          "invoice",
          "validation",
          "meta"
        ],
        "title": "ExtractionSuccess"
      },
      "FileError": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/FileErrorCode"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "FileError"
      },
      "FileErrorCode": {
        "type": "string",
        "enum": [
          "NOT_AN_INVOICE",
          "UNREADABLE_FILE",
          "UNSUPPORTED_FILE_TYPE",
          "FILE_TOO_LARGE",
          "PDF_TOO_MANY_PAGES",
          "EXTRACTION_FAILED"
        ],
        "title": "FileErrorCode"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "Invoice": {
        "properties": {
          "document_type": {
            "$ref": "#/components/schemas/DocumentType",
            "default": "invoice"
          },
          "invoice_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoice Number"
          },
          "issue_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Issue Date",
            "description": "Obligatorio (validación)."
          },
          "due_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Due Date"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10,
                "minLength": 1,
                "description": "ISO 4217 (p. ej. `MXN`). Si no es válido, la validación lo marca."
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency",
            "description": "Obligatorio (validación)."
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "description": "ISO 3166-1 alfa-2 (p. ej. `MX`)."
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "description": "ISO 639-1 (p. ej. `es`)."
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "issuer": {
            "$ref": "#/components/schemas/Party"
          },
          "recipient": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Party"
              },
              {
                "type": "null"
              }
            ]
          },
          "line_items": {
            "items": {
              "$ref": "#/components/schemas/LineItem"
            },
            "type": "array",
            "title": "Line Items"
          },
          "subtotal": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtotal"
          },
          "discount_total": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Discount Total"
          },
          "taxes": {
            "items": {
              "$ref": "#/components/schemas/Tax"
            },
            "type": "array",
            "title": "Taxes"
          },
          "total": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d{1,15}(\\.\\d{1,6})?$",
                "examples": [
                  "1234.50"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Total",
            "description": "Obligatorio (validación)."
          },
          "payment_method": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Method"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "title": "Invoice"
      },
      "Issue": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/IssueCode"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field",
            "description": "Ruta del campo, p. ej. `total` o `line_items.0.amount`."
